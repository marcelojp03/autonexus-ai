# Public local settings. Private credentials live in project-scoped volumes.
COMPOSE_PROJECT_NAME=autonexus-local
WEB_PORT=4280
# PUBLIC_ORIGIN defaults to http://127.0.0.1:<WEB_PORT>.
# PUBLIC_ORIGIN=http://127.0.0.1:4280

# CU16 evidence storage (optional, private to the operator's shell).
# Without a bucket and region the evidence flow answers 503 EVIDENCE_STORAGE_UNAVAILABLE and the
# rest of CU16 keeps working. Credentials are read by the Operations container only; they are never
# committed, baked into an image or sent to the browser. Using an existing bucket may incur usage.
# S3_EVIDENCE_BUCKET=
# S3_EVIDENCE_REGION=
# S3_EVIDENCE_ENDPOINT=
# S3_EVIDENCE_PATH_STYLE=false
# S3_EVIDENCE_UPLOAD_TTL_SECONDS=300
# S3_EVIDENCE_DOWNLOAD_TTL_SECONDS=120
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
