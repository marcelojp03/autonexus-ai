{
  "id": "cu28ExecutionReview",
  "name": "AutoNexus — CU28 evento de revisión al canal local",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cu28-execution-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4a01-8a01-111111111111",
      "name": "Solicitud de revisión (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "webhookId": "3e5c1d90-7a1f-4b25-9c31-0b6f7a2d4e10"
    },
    {
      "parameters": {
        "jsCode": "// The shared secret authenticates the webhook. It is read from the container environment\n// (N8N_BLOCK_ENV_ACCESS_IN_NODE=false is required in n8n 2.x) and is never printed, echoed\n// downstream or stored in the execution data: only the verdict leaves this node.\nconst expected = String($env.CU28_WEBHOOK_SECRET ?? '');\nconst headers = $json.headers ?? {};\nconst provided = String(headers['x-autonexus-secret'] ?? '');\nconst body = $json.body && typeof $json.body === 'object' ? $json.body : {};\nconst authorized = expected.length >= 16 && provided.length === expected.length && provided === expected;\nreturn [{\n  json: {\n    authorized,\n    eventId: typeof body.eventId === 'string' ? body.eventId : '',\n    eventType: typeof body.eventType === 'string' ? body.eventType : '',\n    envelope: body\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4a02-8a02-222222222222",
      "name": "Autenticar y sanear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000000-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4a03-8a03-333333333333",
      "name": "¿Secreto válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Delivered eventIds live in the workflow static data. This node only reads that state and always\n// emits exactly one item, so the webhook answers even when the delivery is a duplicate: n8n's\n// Remove Duplicates node drops the item instead and, in responseMode responseNode, the publisher\n// would wait for a response that never comes.\nconst record = $getWorkflowStaticData('global');\nconst delivered = record.delivered && typeof record.delivered === 'object' ? record.delivered : {};\nconst eventId = String($json.eventId ?? '');\nconst duplicate = eventId.length > 0 && Object.prototype.hasOwnProperty.call(delivered, eventId);\nreturn [{ json: { eventId, duplicate, alreadyDeliveredAt: duplicate ? delivered[eventId] : null, envelope: $json.envelope } }];"
      },
      "id": "a1b2c3d4-0004-4a04-8a04-444444444444",
      "name": "¿Ya entregado? (estado duradero)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000000-0002-4000-8000-000000000002",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4a05-8a05-555555555555",
      "name": "¿Duplicado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'duplicate', eventId: $json.eventId, deliveredAt: $json.alreadyDeliveredAt }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-0006-4a06-8a06-666666666666",
      "name": "Duplicado ya entregado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5680/channel",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.envelope) }}",
        "options": {
          "timeout": 5000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0007-4a07-8a07-777777777777",
      "name": "Canal local de prueba",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        680,
        320
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// The eventId is remembered only after the channel accepted it, so a failed delivery is retried\n// instead of being answered as an already delivered duplicate. The map is capped to the last 500\n// ids so the workflow state cannot grow without limit.\nconst record = $getWorkflowStaticData('global');\nconst delivered = record.delivered && typeof record.delivered === 'object' ? record.delivered : {};\nconst eventId = String($('¿Ya entregado? (estado duradero)').first().json.eventId ?? '');\nif (eventId.length > 0) delivered[eventId] = new Date().toISOString();\nconst ids = Object.keys(delivered);\nif (ids.length > 500) {\n  ids.sort((a, b) => String(delivered[a]).localeCompare(String(delivered[b])));\n  for (const stale of ids.slice(0, ids.length - 500)) delete delivered[stale];\n}\nrecord.delivered = delivered;\nreturn [{ json: { eventId, recorded: true, remembered: Object.keys(delivered).length } }];"
      },
      "id": "a1b2c3d4-0008-4a08-8a08-888888888888",
      "name": "Recordar entrega",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'recorded', eventId: $json.eventId }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "a1b2c3d4-0009-4a09-8a09-999999999999",
      "name": "Aceptado en el canal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'CU28_CHANNEL_UNAVAILABLE' }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "a1b2c3d4-0010-4a10-8a10-aaaaaaaaaaaa",
      "name": "Canal no disponible",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        940,
        560
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'CU28_UNAUTHORIZED' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "a1b2c3d4-0011-4a11-8a11-bbbbbbbbbbbb",
      "name": "No autorizado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        140,
        480
      ]
    }
  ],
