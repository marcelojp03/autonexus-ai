{
  "realm": "autonexus",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "administrador",
        "composite": false
      },
      {
        "name": "recepcionista",
        "composite": false
      },
      {
        "name": "mecanico",
        "composite": false
      },
      {
        "name": "jefe_taller",
        "composite": false
      },
      {
        "name": "responsable_financiero",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "autonexus-shell",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://127.0.0.1:4200/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:4200/"
      },
      "protocolMappers": [
        {
          "name": "autonexus-operations-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autonexus-operations-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
