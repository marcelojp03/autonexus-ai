# Public client configuration only. Flutter assets are bundled into the APK and can be extracted.
# On a physical Android phone connected over USB, use adb reverse to make these loopback URLs reach
# the development laptop without changing the Keycloak issuer.
AUTONEXUS_ISSUER=http://127.0.0.1:4285/identity/realms/autonexus
AUTONEXUS_CLIENT_ID=autonexus-mobile
AUTONEXUS_OWNER_URL=http://127.0.0.1:8081
AUTONEXUS_SYNC_URL=http://127.0.0.1:3005
AUTONEXUS_PREPARATION_DAYS=7
