<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Local development only: the stack runs on http behind the `adb reverse` loopback tunnel, and
         Android blocks cleartext for the discovery document and the REST calls. This overlay applies to
         the debug build: the release build keeps cleartext disabled and requires https. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
