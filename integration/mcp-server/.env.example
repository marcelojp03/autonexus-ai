# Public local configuration. Replace private paths; never put token/secret values here.
NODE_ENV=development
MCP_HOST=127.0.0.1
MCP_PORT=3006
MCP_RESOURCE_URL=http://127.0.0.1:3006/mcp
MCP_ISSUER_URL=http://127.0.0.1:4286/identity/realms/autonexus
MCP_JWKS_URL=http://127.0.0.1:4286/identity/realms/autonexus/protocol/openid-connect/certs
MCP_TOKEN_ENDPOINT_URL=http://127.0.0.1:4286/identity/realms/autonexus/protocol/openid-connect/token
MCP_OPERATIONS_BASE_URL=http://127.0.0.1:8081
MCP_ALLOW_INTERNAL_HTTP_DEV=false
MCP_CLIENT_REGISTRY_FILE=/replace/with/private/absolute/mcp-clients.json
MCP_IDP_CLIENT_FILE=/replace/with/private/absolute/mcp-idp-client.json
MCP_AUDIT_FILE=/replace/with/private/absolute/audit.jsonl
