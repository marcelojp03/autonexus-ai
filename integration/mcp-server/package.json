{
  "name": "autonexus-mcp-server",
  "version": "0.1.0",
  "description": "Independent read-only MCP service over authorized AutoNexus APIs",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "start": "node dist/main.js"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "22.22.3",
